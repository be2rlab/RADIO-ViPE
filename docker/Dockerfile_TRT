FROM nvcr.io/nvidia/pytorch:25.02-py3 AS base
SHELL [ "/bin/bash", "-c" ]
ENV DEBIAN_FRONTEND=noninteractive
ENV USER=user

RUN apt-get update && apt-get install -y --no-install-recommends ubuntu-keyring && \
    apt-get autoclean

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        gnupg2 ca-certificates ubuntu-keyring curl \
        sudo git wget nano unzip ffmpeg libsm6 libxext6 ninja-build cmake build-essential libopenblas-dev \
        xterm xauth openssh-server tmux mate-desktop-environment-core \
        libglvnd0 libgl1 libglx0 libegl1 libx11-6 \
        libxkbcommon-x11-0 libxkbcommon0 libx11-xcb1 libxcb1 libxcb-render0 libxcb-shape0 libxcb-xfixes0 \
        libvulkan1 libeigen3-dev zlib1g-dev && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=graphics,utility,compute
ENV QT_X11_NO_MITSHM=1
# Silence the numexpr "detected N cores" noise at every run
ENV NUMEXPR_MAX_THREADS=16

COPY ../envs/ envs/
RUN pip install -r envs/requirements.txt

RUN pip install scikit-learn
RUN pip install ftfy regex tqdm
RUN pip install "numpy<2" "opencv-python<5" --force-reinstall

# TensorRT
RUN pip install torch-tensorrt --no-deps
RUN pip install git+https://github.com/NVIDIA-AI-IOT/torch2trt.git --no-deps

RUN pip install ultralytics \
                segment-anything-py \
                open-clip-torch \
                transformers==4.52

RUN TORCH_VER=$(python3 -c "import torch; print(torch.__version__.split('+')[0])") && \
    CUDA_VER=$(python3 -c "import torch; print('cu' + torch.version.cuda.replace('.', ''))") && \
    pip install torch-scatter -f "https://data.pyg.org/whl/torch-${TORCH_VER}+${CUDA_VER}.html"

# ── AOT-compile vipe_ext_jit so it lands in site-packages, not the JIT cache ──
# We copy only the two things the build needs: the C++/CUDA sources and the
# setup script. The workdir (/home/user/km-vipe) is volume-mounted at runtime
# so we build in /tmp and let pip install the .so into the Python environment.
COPY csrc/       /tmp/ext_build/csrc/
COPY setup_ext.py /tmp/ext_build/setup.py
RUN cd /tmp/ext_build && \
    pip install --no-build-isolation . && \
    rm -rf /tmp/ext_build
# ──────────────────────────────────────────────────────────────────────────────

WORKDIR /home/${USER}/km-vipe
CMD ["/bin/bash"]